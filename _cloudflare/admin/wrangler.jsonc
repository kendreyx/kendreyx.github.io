{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kendrey-blog-private-admin",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": ""
  }
}
