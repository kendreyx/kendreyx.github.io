{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kendrey-blog-private-admin",
  "account_id": "451eb562c4e121f7edb96a72ab72a7bd",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.kendrey.top",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": ""
  }
}
